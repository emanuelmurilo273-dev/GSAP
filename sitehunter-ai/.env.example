# ============================================================
# SiteHunter AI — variáveis de ambiente (copie para .env)
# NUNCA versione o .env com valores reais.
# ============================================================

# --- Obrigatórias -------------------------------------------
# PostgreSQL
DATABASE_URL="postgresql://USUARIO:SENHA@HOST:5432/sitehunter"
# Endereço público do painel (sem barra no final)
APP_URL="https://app.seudominio.com.br"
# Domínio raiz dos sites publicados: <slug>.ROOT_DOMAIN  (ex.: sitehunter.app)
ROOT_DOMAIN="seudominio.com.br"
# Segredo para a rotina periódica (/api/cron/subscriptions). Gere com: openssl rand -hex 32
CRON_SECRET=""
# E-mails que viram administradores ao se cadastrar (separados por vírgula)
ADMIN_EMAILS="voce@seudominio.com.br"

# --- Pagamentos: Kiwify -------------------------------------
# Token definido ao criar o webhook na Kiwify (Apps → Webhooks). Usado para validar a assinatura HMAC.
KIWIFY_WEBHOOK_TOKEN=""
# Token anterior, apenas durante uma troca de token (opcional)
KIWIFY_WEBHOOK_TOKEN_PREVIOUS=""
# Link do checkout do produto de assinatura (também configurável no painel admin)
KIWIFY_CHECKOUT_URL="https://pay.kiwify.com.br/SEU_PRODUTO"
# API pública da Kiwify (opcional, reservado para conciliação futura)
KIWIFY_CLIENT_ID=""
KIWIFY_CLIENT_SECRET=""
KIWIFY_ACCOUNT_ID=""

# --- Busca de empresas: Google Places API (New) -------------
# Restrinja a chave por IP do servidor e à "Places API (New)" no Google Cloud Console.
GOOGLE_PLACES_API_KEY=""

# --- Inteligência artificial: Anthropic (Claude) ------------
# Sem esta chave, os sites/propostas/mensagens usam textos-modelo (sinalizados na interface).
ANTHROPIC_API_KEY=""
AI_MODEL="claude-opus-5-5"

# --- Banco de imagens: Unsplash (opcional) ------------------
UNSPLASH_ACCESS_KEY=""

# --- E-mail transacional (SMTP) -----------------------------
# Sem SMTP, os e-mails (verificação, redefinição de senha, avisos) são apenas registrados no log.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="SiteHunter AI <nao-responda@seudominio.com.br>"
# "true" exige e-mail confirmado para usar os recursos Premium
REQUIRE_EMAIL_VERIFICATION="false"

# --- Domínios próprios (opcional) ---------------------------
# IPs públicos do servidor, para verificar registros A de domínios de clientes (separados por vírgula)
PUBLIC_SERVER_IPS=""

# --- Docker Compose -----------------------------------------
POSTGRES_PASSWORD=""
ACME_EMAIL="voce@seudominio.com.br"
