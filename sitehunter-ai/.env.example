# ============================================================
# SiteHunter AI — variáveis de ambiente (copie para .env)
# NUNCA versione o .env com valores reais.
# ============================================================

# --- Obrigatórias -------------------------------------------
# PostgreSQL
DATABASE_URL="postgresql://USUARIO:SENHA@HOST:5432/sitehunter"
# Endereço público do painel (sem barra no final)
APP_URL="https://app.seudominio.com.br"
# Domínio raiz dos sites publicados: <slug>.ROOT_DOMAIN  (ex.: sitehunter.app)
ROOT_DOMAIN="seudominio.com.br"
# Segredo para a rotina periódica (/api/cron/subscriptions). Gere com: openssl rand -hex 32
CRON_SECRET=""
# --- Acesso ---------------------------------------------------
# "private" (padrão): painel de uso exclusivo do proprietário, SEM cadastro público.
# Crie a conta com:  npm run owner:create -- voce@seudominio.com.br "Seu nome"
# "saas": modo multiusuário com cadastro e assinatura Kiwify.
ACCESS_MODE="private"
# E-mail da conta proprietária. Quando definido, só ela consegue entrar (mesmo que existam outros administradores).
OWNER_EMAIL="voce@seudominio.com.br"
# Modo saas: e-mails que viram administradores ao se cadastrar (separados por vírgula)
ADMIN_EMAILS="voce@seudominio.com.br"

# --- Pagamentos: Kiwify -------------------------------------
# Token definido ao criar o webhook na Kiwify (Apps → Webhooks). Usado para validar a assinatura HMAC.
KIWIFY_WEBHOOK_TOKEN=""
# Token anterior, apenas durante uma troca de token (opcional)
KIWIFY_WEBHOOK_TOKEN_PREVIOUS=""
# Link do checkout do produto de assinatura (também configurável no painel admin)
KIWIFY_CHECKOUT_URL="https://pay.kiwify.com.br/SEU_PRODUTO"
# API pública da Kiwify (opcional, reservado para conciliação futura)
KIWIFY_CLIENT_ID=""
KIWIFY_CLIENT_SECRET=""
KIWIFY_ACCOUNT_ID=""

# --- Busca de empresas: Google Places API (New) -------------
# Restrinja a chave por IP do servidor e à "Places API (New)" no Google Cloud Console.
# Sem ela, o Estúdio de leads funciona com o modo Demonstração (dados fictícios) e com importação de CSV.
GOOGLE_PLACES_API_KEY=""

# --- Inteligência artificial: Anthropic (Claude) ------------
# Sem esta chave, os sites/propostas/mensagens usam textos-modelo (sinalizados na interface).
ANTHROPIC_API_KEY=""
AI_MODEL="claude-opus-5-5"

# --- Busca de empresas: OpenStreetMap (sem chave) ------------
# Nominatim exige identificação e no máximo 1 consulta por segundo (o app já respeita).
# Política: https://operations.osmfoundation.org/policies/nominatim/
OSM_CONTACT_EMAIL="voce@seudominio.com.br"
# Opcional: instância própria do Nominatim para volume maior
NOMINATIM_URL=""

# --- Imagens com licença --------------------------------------
# Sem chave: Openverse (CC0, CC BY, CC BY-SA com uso comercial e modificação), com crédito automático.
# Opcional: token do Openverse para limite maior (https://api.openverse.org/v1/#tag/auth)
OPENVERSE_TOKEN=""
# Opcional: Unsplash (quando definida, substitui o Openverse)
UNSPLASH_ACCESS_KEY=""
# "off" desativa a busca de imagens
IMAGE_SEARCH=""

# --- Google Flow ----------------------------------------------
# Não há variável: o Google Flow não tem API pública. A integração é assistida
# (prompt preparado pelo sistema + importação manual da imagem gerada).

# --- E-mail transacional (SMTP) -----------------------------
# Sem SMTP, os e-mails (verificação, redefinição de senha, avisos) são apenas registrados no log.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="SiteHunter AI <nao-responda@seudominio.com.br>"
# "true" exige e-mail confirmado para usar os recursos Premium
REQUIRE_EMAIL_VERIFICATION="false"

# --- Domínios próprios (opcional) ---------------------------
# IPs públicos do servidor, para verificar registros A de domínios de clientes (separados por vírgula)
PUBLIC_SERVER_IPS=""

# --- Docker Compose -----------------------------------------
POSTGRES_PASSWORD=""
ACME_EMAIL="voce@seudominio.com.br"

# ---------- Link público das prévias (opcional) ----------
# Repositório PÚBLICO no seu GitHub + token fine-grained só para ele (Contents: Read and write).
# O link sai no GitHub Pages (https://<usuario>.github.io/<repo>/...). Ative o Pages no repositório uma vez.
GITHUB_PREVIEWS_TOKEN=""
GITHUB_PREVIEWS_REPO=""          # ex.: seu-usuario/sitehunter-previas
GITHUB_PREVIEWS_BRANCH="main"
GITHUB_PREVIEWS_DIR="previas"
GITHUB_PAGES_URL=""              # só com domínio próprio, ex.: https://previas.seudominio.com.br
