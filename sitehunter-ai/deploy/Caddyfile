# Caddy: HTTPS automático (Let's Encrypt) para o painel, para cada
# <slug>.ROOT_DOMAIN e para domínios próprios verificados.
# O "ask" consulta a aplicação antes de emitir cada certificado.
{
	email {$ACME_EMAIL}
	on_demand_tls {
		ask http://app:3000/api/domains/check
	}
}

https:// {
	tls {
		on_demand
	}
	encode gzip zstd
	reverse_proxy app:3000 {
		header_up X-Forwarded-Host {host}
	}
}

http:// {
	redir https://{host}{uri} permanent
}
