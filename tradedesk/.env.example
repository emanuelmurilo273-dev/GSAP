# ───────── Plano / pagamentos ─────────
PLAN_PRICE=7000                      # valor mensal em R$ (o admin pode sobrescrever no painel)
OWNER_PIX_KEY=                       # sua chave Pix para o repasse automático do saldo do Asaas
OWNER_PIX_KEY_TYPE=EVP               # CPF | CNPJ | EMAIL | PHONE | EVP
MIN_PAYOUT=100                       # só repassa quando o saldo do Asaas for >= este valor (R$)
ASAAS_API_KEY=
ASAAS_WEBHOOK_SECRET=                # o MESMO "token de autenticação" configurado no webhook do Asaas
ASAAS_BASE_URL=https://api.asaas.com/v3   # sandbox: https://api-sandbox.asaas.com/v3

# ───────── E-mail ─────────
RESEND_API_KEY=
EMAIL_FROM="HEXADESK <noreply@seudominio.com>"

# ───────── Supabase ─────────
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=                        # service_role key (SOMENTE servidor e worker — nunca no front)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=       # anon key (pública)

# ───────── Segurança ─────────
ENCRYPTION_KEY=                      # 32 bytes: openssl rand -hex 32   (perdeu = chaves dos clientes ilegíveis)

# ───────── LLM (Analyst) ─────────
LLM_API_KEY=
LLM_PROVIDER=anthropic               # anthropic | openai
LLM_MODEL=claude-haiku-5-5

# ───────── Worker (Railway) ─────────
REDIS_URL=redis://localhost:6379

# ───────── Dono, modos e segurança ─────────
OWNER_EMAIL=                         # seu e-mail: vira dono (role=owner) no 1º login, sem checkout. Também recebe os alertas
BINANCE_TESTNET=false                # true = ordens na Binance Spot TESTNET (dinheiro de mentira; chaves de testnet.binance.vision)
STRATEGY_APPROVED=false              # só vire true se research/RESEARCH.md aprovar uma estratégia. false = clientes sem modo real
ENABLE_MERCADO_BITCOIN=false         # desligado: não dá para verificar a permissão de saque da chave
CRON_SECRET=                         # openssl rand -hex 24 (protege /api/cron/watchdog)
PREVIEW_PAGES=false                  # true só em desenvolvimento: libera /preview (telas com dados de EXEMPLO)

# ───────── App ─────────
NEXT_PUBLIC_APP_NAME=HEXADESK
NEXT_PUBLIC_APP_URL=http://localhost:3000
WEB_PORT=3000                        # porta do site no seu PC (o instalador troca se estiver ocupada)
