# ───────── Plano / pagamentos ─────────
PLAN_PRICE=7000                      # valor mensal em R$ (o admin pode sobrescrever no painel)
OWNER_PIX_KEY=                       # sua chave Pix para o repasse automático do saldo do Asaas
OWNER_PIX_KEY_TYPE=EVP               # CPF | CNPJ | EMAIL | PHONE | EVP
MIN_PAYOUT=100                       # só repassa quando o saldo do Asaas for >= este valor (R$)
ASAAS_API_KEY=
ASAAS_WEBHOOK_SECRET=                # o MESMO "token de autenticação" configurado no webhook do Asaas
ASAAS_BASE_URL=https://api.asaas.com/v3   # sandbox: https://api-sandbox.asaas.com/v3

# ───────── E-mail ─────────
RESEND_API_KEY=
EMAIL_FROM="HEXADESK <noreply@seudominio.com>"

# ───────── Supabase ─────────
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=                        # service_role key (SOMENTE servidor e worker — nunca no front)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=       # anon key (pública)

# ───────── Segurança ─────────
ENCRYPTION_KEY=                      # 32 bytes: openssl rand -hex 32   (perdeu = chaves dos clientes ilegíveis)

# ───────── LLM (Analyst) ─────────
LLM_API_KEY=
LLM_PROVIDER=anthropic               # anthropic | openai
LLM_MODEL=claude-haiku-5-5

# ───────── Worker (Railway) ─────────
REDIS_URL=redis://localhost:6379

# ───────── Dono, modos e segurança ─────────
OWNER_EMAIL=                         # seu e-mail: vira dono (role=owner) no 1º login, sem checkout. Também recebe os alertas
EXCHANGES_ENABLED=foxbit             # corretoras de cripto liberadas (a 1ª é a padrão). Ex.: foxbit,mercado  (mercado exige ENABLE_MERCADO_BITCOIN=true)
EXCHANGE_TESTNET=false               # true = Binance/Bybit em TESTNET (dinheiro de mentira; chaves de testnet.binance.vision / testnet.bybit.com)
BINANCE_TESTNET=false                # igual ao EXCHANGE_TESTNET (nome antigo, continua valendo)
STRATEGY_APPROVED=false              # só vire true se uma estratégia passar no teste fora da amostra (PF≥1,3, drawdown≤15%, ≥300 trades). false = clientes não operam
SALES_OPEN=false                     # venda/checkout: só abre se STRATEGY_APPROVED=true E isto = true. Antes disso a landing mostra lista de espera
CRYPTO_MAX_TRADES_PER_DAY=6          # máximo de operações de cripto por cliente por dia
ENABLE_MERCADO_BITCOIN=false         # desligado: não dá para verificar a permissão de saque da chave
OWNER_REQUIRE_2FA=true               # false SÓ vale em instalação local (site em localhost); na internet é ignorado
OWNER_HOME=/admin                    # para onde o dono vai após o login (padrão: /admin; /b3 é o Laboratório da B3)
CRON_SECRET=                         # openssl rand -hex 24 (protege /api/cron/watchdog)
PREVIEW_PAGES=false                  # true só em desenvolvimento: libera /preview (telas com dados de EXEMPLO)

# ───────── Avisos no celular (opcional, grátis) ─────────
NTFY_TOPIC=                          # instale o app ntfy, assine um tópico secreto (ex.: hexadesk-xxxxxxxx) e coloque o nome aqui

# ───────── App ─────────
NEXT_PUBLIC_APP_NAME=HEXADESK
NEXT_PUBLIC_APP_URL=http://localhost:3000
WEB_PORT=3000                        # porta do site no seu PC (o instalador troca se estiver ocupada)
